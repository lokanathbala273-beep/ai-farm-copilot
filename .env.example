# Application Environment Configuration
PROJECT_NAME="AI Farm Co-Pilot & Market Optimizer"
VERSION=1.0.0
PORT=8080
HOST=0.0.0.0

# Security
SECRET_KEY=agritech-super-secret-jwt-key-2026-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (SQLite by default, or PostgreSQL)
DATABASE_URL=sqlite:///database/farm_copilot.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_farm_copilot

# AI Configuration
ACTIVE_MODEL_VERSION=AgroVision-Ensemble-v1.0
CONFIDENCE_THRESHOLD=0.70

# SMS Gateway Configuration (For real cellular SMS delivery to mobile phones)
# Options: Fast2SMS (Recommended for India), Twilio, or MSG91
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
MSG91_AUTH_KEY=

